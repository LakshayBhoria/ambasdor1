NODE_ENV=development
PORT=4100
COMPANY_NAME=ThinKorix
MAIN_SITE=https://www.thinkorix.com
# Where /r/<CODE> share links send students (your internship registration page)
REGISTER_URL=https://www.thinkorix.com
# Public URL of the FRONTEND (your Vercel URL). Used in emails and share links.
APP_URL=http://localhost:4100
# Comma-separated browser origins allowed to call the API directly (not needed when Vercel rewrites /api)
CORS_ORIGINS=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE-ME-long-random
SEED_ADMIN_EMAIL=admin@thinkorix.com
SEED_ADMIN_PASSWORD=change-this-password
# Shared secret for Google Form / main site / payment webhook calling /api/ambassador/integrations/*
INTEGRATION_SECRET=CHANGE-ME-integration-secret
COMMISSION_PER_REFERRAL=100
STIPEND_TEXT=₹9,000+
INSTAGRAM_URL=
LINKEDIN_URL=
SEND_EMAIL=false
MAIL_FROM=ThinKorix <no-reply@thinkorix.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# local (JSON files, development only) or firestore (required in production)
DB_DRIVER=local
FIREBASE_PROJECT_ID=
# Render: paste the whole service-account JSON here
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
